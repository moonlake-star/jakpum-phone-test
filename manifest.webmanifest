{
  "name": "작품 보컬노트 폰 실험",
  "short_name": "보컬노트실험",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "lang": "ko",
  "background_color": "#ffffff",
  "theme_color": "#2b4c7e",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            "text/*",
            ".m4a",
            ".mp3",
            ".wav",
            ".aac",
            ".3gp",
            ".amr",
            ".ogg",
            ".opus",
            ".txt",
            ".srt",
            ".vtt",
            ".json"
          ]
        }
      ]
    }
  }
}